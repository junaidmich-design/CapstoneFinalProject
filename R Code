# --- 3. SERVER LOGIC ---
server <- function(input, output) {
  
  # --- KPI Boxes ---
  output$totalEmployees <- renderValueBox({
    valueBox(nrow(phishing_data), "Employees Tracked", icon = icon("users"), color = "blue")
  })
  
  output$avgQuizScore <- renderValueBox({
    avg_score <- round(mean(phishing_data$Quiz_Score, na.rm = TRUE), 1)
    valueBox(paste0(avg_score, "%"), "Avg. Quiz Score", icon = icon("check-circle"), color = "green")
  })
  
  output$phishingClickRate <- renderValueBox({
    click_rate <- round((sum(phishing_data$Clicked_Phishing == 1) / nrow(phishing_data)) * 100, 1)
    valueBox(paste0(click_rate, "%"), "Phishing Click Rate", icon = icon("mouse-pointer"), color = "red")
  })
  
  output$highRiskCount <- renderValueBox({
    high_risk <- sum(phishing_data$Risk_Profile == "High Risk")
    valueBox(high_risk, "High Risk Employees", icon = icon("exclamation-triangle"), color = "orange")
  })
  
  # --- Plots ---
  
  # 1. Risk Plot (Overview Tab)
  output$riskPlot <- renderPlot({
    phishing_data %>%
      count(Department, Risk_Profile) %>%
      ggplot(aes(x = reorder(Department, -n), y = n, fill = factor(Risk_Profile, levels = c("High Risk", "Medium Risk", "Low Risk")))) +
      geom_bar(stat = "identity", position = "stack", color = "black", alpha = 0.8) +
      theme_minimal(base_size = 14) +
      labs(x = "Department", y = "Employee Count", fill = "Risk Profile") +
      scale_fill_manual(values = c("High Risk" = "#dc3545", "Medium Risk" = "#ffc107", "Low Risk" = "#28a745"))
  })
  
  # 2. Phishing Bar Plot
  output$phishingPlot <- renderPlot({
    phishing_data %>%
      group_by(Department) %>%
      summarise(Clicked = sum(Clicked_Phishing == 1),
                Ignored = sum(Clicked_Phishing == 0)) %>%
      pivot_longer(cols = c(Clicked, Ignored), names_to = "Result", values_to = "Count") %>%
      ggplot(aes(x = reorder(Department, -Count), y = Count, fill = Result)) +
      geom_bar(stat = "identity", position = "dodge", color = "black", alpha = 0.8) +
      theme_minimal(base_size = 14) +
      labs(x = "Department", y = "Simulations Sent", fill = "Action Taken") +
      scale_fill_manual(values = c("Clicked" = "#dc3545", "Ignored" = "#17a2b8"))
  })
  
  # 3. Phishing Pie Chart
  output$phishingPie <- renderPlot({
    phishing_data %>%
      count(Clicked_Phishing) %>%
      mutate(Label = ifelse(Clicked_Phishing == 1, "Clicked", "Ignored")) %>%
      ggplot(aes(x = "", y = n, fill = Label)) +
      geom_bar(stat = "identity", width = 1, color = "white") +
      coord_polar("y", start = 0) +
      theme_void(base_size = 14) +
      scale_fill_manual(values = c("Clicked" = "#dc3545", "Ignored" = "#17a2b8")) +
      labs(fill = "")
  })
  
  # 4. Quiz Plot (Boxplot to show spread)
  output$quizPlot <- renderPlot({
    ggplot(phishing_data, aes(x = Department, y = Quiz_Score, fill = Department)) +
      geom_boxplot(alpha = 0.7) +
      theme_minimal(base_size = 14) +
      labs(x = "Department", y = "Quiz Score (%)") +
      theme(legend.position = "none")
  })
  
  # 5. Completion Plot
  output$completionPlot <- renderPlot({
    phishing_data %>%
      count(Training_Completed) %>%
      ggplot(aes(x = Training_Completed, y = n, fill = Training_Completed)) +
      geom_bar(stat = "identity", color = "black", width = 0.5) +
      theme_minimal(base_size = 14) +
      labs(x = "Completed?", y = "Count") +
      scale_fill_manual(values = c("Yes" = "#28a745", "No" = "#6c757d")) +
      theme(legend.position = "none")
  })
  
  # 6. Compliance Plot
  output$compliancePlot <- renderPlot({
    phishing_data %>%
      count(Department, Compliance_Status) %>%
      ggplot(aes(x = reorder(Department, -n), y = n, fill = Compliance_Status)) +
      geom_bar(stat = "identity", position = "dodge", color = "black") +
      theme_minimal(base_size = 14) +
      labs(x = "Department", y = "Employee Count", fill = "Status") +
      scale_fill_manual(values = c("Compliant" = "#28a745", "Non-Compliant" = "#dc3545"))
  })
  
  # --- Data Table (Remediation Center) ---
  output$actionTable <- renderDataTable({
    # Filter for employees who need attention
    action_data <- phishing_data %>%
      filter(Compliance_Status == "Non-Compliant" | Risk_Profile == "High Risk" | Training_Completed == "No") %>%
      select(Employee_ID, Department, Risk_Profile, Quiz_Score, Training_Completed, Compliance_Status) %>%
      arrange(Risk_Profile)
    
    action_data
  }, options = list(pageLength = 10, scrollX = TRUE))
}

# --- 4. RUN APP ---
shinyApp(ui, server)
