# --- 1. ENHANCED SMART DATA LOADING ---
load_or_mock_data <- function() {
  # If you use your real CSV later, ensure it has these column names
  set.seed(42) # For consistent mock data
  
  mock_df <- data.frame(
    Employee_ID = paste0("EMP-", 1001:1200),
    Department = sample(c("IT", "HR", "Finance", "Operations", "Sales"), 200, replace = TRUE),
    Quiz_Score = round(rnorm(200, mean = 75, sd = 15), 0),
    Clicked_Phishing = sample(c(0, 1), 200, replace = TRUE, prob = c(0.85, 0.15)), 
    Compliance_Status = sample(c("Compliant", "Non-Compliant"), 200, replace = TRUE, prob = c(0.80, 0.20)),
    Training_Completed = sample(c("Yes", "No"), 200, replace = TRUE, prob = c(0.88, 0.12))
  ) %>%
    # Add logic: if they failed training or clicked phishing, they are higher risk
    mutate(
      Quiz_Score = ifelse(Quiz_Score > 100, 100, ifelse(Quiz_Score < 0, 0, Quiz_Score)),
      Risk_Profile = case_when(
        Clicked_Phishing == 1 & Quiz_Score < 70 ~ "High Risk",
        Clicked_Phishing == 1 | Quiz_Score < 70 ~ "Medium Risk",
        TRUE ~ "Low Risk"
      )
    )
  
  return(mock_df)
}

phishing_data <- load_or_mock_data()

